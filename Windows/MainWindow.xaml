<Window x:Class="SafeMacCleaner.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeMac Cleaner Lite"
        Icon="AppIcon.png"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#030407"
        Foreground="#FAFAFA">

    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#070A0F" Offset="0"/>
            <GradientStop Color="#030407" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E16" Offset="0"/>
            <GradientStop Color="#05070B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#131620" Offset="0"/>
            <GradientStop Color="#090B12" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#318CFF" Offset="0"/>
            <GradientStop Color="#9E40FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NavRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Background" Value="#090B12"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter Margin="12,0"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#487B5CFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#171E38"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#945AFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B36EFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Background" Value="#0E1119"/>
            <Setter Property="BorderBrush" Value="#407B5CFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6B8D73FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24365C"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#318CFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="MaxWidth" Value="250"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="17"
                                Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#080A0F"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#080A0F"/>
            <Setter Property="AlternatingRowBackground" Value="#0C0E15"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0C0F16"/>
            <Setter Property="Foreground" Value="#B8B8B8"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Foreground" Value="#F6F6F6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="#12FFFFFF"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44"
                            CornerRadius="12"
                            Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="✦"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,3,0,0">
                        <TextBlock Text="SafeMac Cleaner"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Lite · 本地安全清理"
                                   Foreground="#BABABA"
                                   FontSize="10.5"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="核心功能"
                           Foreground="#7A7A7A"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Bottom"/>

                <StackPanel Grid.Row="2" Margin="0,9,0,0">
                    <RadioButton x:Name="SmartNav"
                                 GroupName="Nav"
                                 Tag="Smart"
                                 IsChecked="True"
                                 Click="Navigation_Click"
                                 Style="{StaticResource NavRadioStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="11"
                                    Background="#18345C">
                                <TextBlock Text="✦" Foreground="#318CFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="智能扫描" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="缓存 / 日志 / 项目垃圾"
                                           Foreground="#BABABA" FontSize="10.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="LargeNav"
                                 GroupName="Nav"
                                 Tag="Large"
                                 Click="Navigation_Click"
                                 Style="{StaticResource NavRadioStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="11"
                                    Background="#13FFFFFF">
                                <TextBlock Text="▤" Foreground="#318CFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="17"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="大文件" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Downloads / Work / Videos"
                                           Foreground="#BABABA" FontSize="10.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="AppsNav"
                                 GroupName="Nav"
                                 Tag="Apps"
                                 Click="Navigation_Click"
                                 Style="{StaticResource NavRadioStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="11"
                                    Background="#13FFFFFF">
                                <TextBlock Text="⌁" Foreground="#318CFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="应用卸载" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="本体 + 配置 + 关联文件"
                                           Foreground="#BABABA" FontSize="10.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="LeftoversNav"
                                 GroupName="Nav"
                                 Tag="Leftovers"
                                 Click="Navigation_Click"
                                 Style="{StaticResource NavRadioStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="11"
                                    Background="#13FFFFFF">
                                <TextBlock Text="◈" Foreground="#318CFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="应用残留" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="孤儿配置 / AppData / ProgramData"
                                           Foreground="#BABABA" FontSize="10.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="4"
                        CornerRadius="15"
                        Background="#111226"
                        BorderBrush="#407B5CFF"
                        BorderThickness="1"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="安全清理" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="默认进入回收站，可恢复；不执行永久删除。"
                                   TextWrapping="Wrap"
                                   Foreground="#BABABA"
                                   FontSize="10.5"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="DiskFreeSidebar"
                                   Foreground="#BABABA"
                                   FontSize="10.5"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,18,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="PageTitle"
                               Text="智能扫描"
                               FontSize="27"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle"
                               Text="缓存、日志、Crashpad、开发缓存和项目可重建产物。"
                               Foreground="#BABABA"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                    <Border x:Name="Badge"
                            Background="#17345C"
                            BorderBrush="#24318CFF"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="12,4"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0">
                        <TextBlock x:Name="BadgeText"
                                   Text="智能清理"
                                   Foreground="#318CFF"
                                   FontWeight="SemiBold"
                                   FontSize="11"/>
                    </Border>
                </StackPanel>

                <Button x:Name="ScanControlButton"
                        Grid.Column="1"
                        Width="132"
                        Content="重新扫描"
                        Visibility="Collapsed"
                        Click="ScanControl_Click"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <Button x:Name="MainActionButton"
                        Grid.Column="3"
                        Content="开始智能扫描"
                        Click="MainAction_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="可处理空间" Foreground="#BABABA" FontSize="11"/>
                        <TextBlock x:Name="MetricCandidate" Text="—"
                                   FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="MetricCandidateSub" Text="尚未扫描"
                                   Foreground="#7A7A7A" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="已勾选" Foreground="#BABABA" FontSize="11"/>
                        <TextBlock x:Name="MetricSelected" Text="—"
                                   FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="MetricSelectedSub" Text="等待扫描"
                                   Foreground="#7A7A7A" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="发现项目" Foreground="#BABABA" FontSize="11"/>
                        <TextBlock x:Name="MetricFound" Text="0"
                                   FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="MetricFoundSub" Text="扫描结果"
                                   Foreground="#7A7A7A" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Background="#1FFFFFFF"
                    CornerRadius="4">
                <Grid>
                    <Border x:Name="ProgressFill"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            Width="0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="78"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ScanPathText"
                               Text="当前：—"
                               Foreground="#BABABA"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ScanMetricsText"
                               Text="阶段 — · 已扫描 0 · 已发现 0 · 用时 00:00"
                               Foreground="#7A7A7A"
                               FontFamily="Consolas"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="PauseButton"
                        Grid.Column="1"
                        Content="暂停"
                        Visibility="Collapsed"
                        Click="Pause_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="32"
                        Padding="10,0"/>
            </Grid>

            <Border Grid.Row="7"
                    CornerRadius="14"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    Background="#080A0F"
                    ClipToBounds="True">
                <DataGrid x:Name="ResultsGrid"
                          SelectionChanged="ResultsGrid_SelectionChanged"
                          CurrentCellChanged="ResultsGrid_CurrentCellChanged"/>
            </Border>

            <Grid Grid.Row="8">
                <TextBlock x:Name="StatusText"
                           Text="尚未扫描 · 点击主按钮开始智能扫描"
                           Foreground="#BABABA"
                           FontSize="11"
                           VerticalAlignment="Bottom"/>
                <TextBlock Text="本地处理 · 可恢复"
                           Foreground="#7A7A7A"
                           FontSize="11"
                           FontWeight="Medium"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
