<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SafeMacCleanerLite</AssemblyName>
    <RootNamespace>SafeMacCleaner.Windows</RootNamespace>
    <Version>4.14.0</Version>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AppIcon.png" />
  </ItemGroup>

  <Target Name="PreparePlanAApplicationIcon" BeforeTargets="CoreCompile" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\prepare_app_icon.ps1&quot;" />
  </Target>
</Project>
